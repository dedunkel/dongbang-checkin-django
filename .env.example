# 로컬 개발용 예시. 실제 값으로 바꿔서 .env 파일을 만드세요.

# Postgres를 쓸 때: (Supabase/Neon 등 관리형 Postgres도 이 형식의 connection string을 줍니다)
DATABASE_URL="postgresql://postgres:devpassword@localhost:5432/dongbang_checkin_django"
# DATABASE_URL을 비워두면 자동으로 로컬 SQLite(db.sqlite3)를 씁니다 (빠르게 켜볼 때용).

# 기존 구글 폼 → /api/import/google-form/ 요청 인증용 공유 비밀키.
# 아무 문자열이나 넣고, google-apps-script/Forwarder.gs의 CONFIG.IMPORT_SECRET에도
# 반드시 똑같은 값을 넣어야 합니다.
IMPORT_SECRET="change-this-to-a-random-string"

# 체크인 시 인포/공연장 점수 시트("도착 여부" 컬럼)에 실시간 반영하려면 채웁니다.
# google-apps-script/SheetSync.gs를 그 시트에 붙이고 웹 앱으로 배포해서 나온 URL과,
# SheetSync.gs의 CONFIG.SECRET과 동일한 값을 넣어야 합니다. 비워두면 이 기능만 꺼집니다.
SHEET_SYNC_URL=""
SHEET_SYNC_SECRET=""

# 배포 시에만 필요:
DJANGO_SECRET_KEY="change-this-in-production"
DJANGO_DEBUG="1"
DJANGO_ALLOWED_HOSTS="localhost,127.0.0.1"
# 배포 도메인을 스킴(https://)까지 포함해서 — 없으면 /admin 로그인 등 POST 요청이
# CSRF 오류로 막힙니다. 예: "https://your-app.onrender.com"
DJANGO_CSRF_TRUSTED_ORIGINS=""
